# ===========================================
# OS files
# ===========================================
.DS_Store
Thumbs.db
desktop.ini

# ===========================================
# IDE / Editor
# ===========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ===========================================
# Terraform
# ===========================================
# Local .terraform dirs (provider plugins / modules -- huge binaries)
**/.terraform/*
# State files contain secrets and must never be committed
*.tfstate
*.tfstate.*
*.tfstate.backup
# Crash logs
crash.log
crash.*.log
# Variable files (may contain secrets / credentials)
*.tfvars
*.tfvars.json
# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Plan output files
*.tfplan
*.plan
# CLI config files
.terraformrc
terraform.rc
# NOTE: .terraform.lock.hcl is intentionally NOT ignored --
# it should be committed for reproducible provider versions.

# ===========================================
# Node / React
# ===========================================
node_modules/
.pnp
.pnp.js
coverage/
build/
dist/
.eslintcache
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===========================================
# Environment / secrets
# ===========================================
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.pem
*.key
id_rsa*
.vault-pass
vault-pass-file

# ===========================================
# Ansible
# ===========================================
*.retry
.ansible/

# ===========================================
# Docker
# ===========================================
docker-compose.override.yml

# ===========================================
# Logs & misc
# ===========================================
*.log
logs/
tmp/
.DS_Store
